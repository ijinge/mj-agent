# mj-agent 环境变量模板
# 复制为 .env 后按需修改；Settings 会优先读取环境变量再 fallback 到 config/config.yaml
#
# === 部署形态（重要）===
# 1) 本机全栈：redis/postgres 也跑在本机 → 保持默认 127.0.0.1
# 2) 远端依赖：redis/postgres 跑在另一台服务器（推荐用 docker-compose.yml 部署）→
#    把下面的 <server-ip> 替换成服务器实际 IP / 域名，例：192.168.1.20 或 redis.example.com

# ---- 运行模式 ----
MJ_ENV=dev
MJ_LOG_LEVEL=INFO
MJ_LOG_FILE=

# ---- Redis ----
# 本机: redis://127.0.0.1:6379/0
# 远端: redis://<server-ip>:6379/0
MJ_REDIS_URL=redis://127.0.0.1:6379/0

# ---- Database ----
# 本机: postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/mjagent
# 远端: postgresql+asyncpg://postgres:postgres@<server-ip>:5432/mjagent
MJ_DB_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/mjagent

# ---- Gateway ----
MJ_GATEWAY_HOST=0.0.0.0
MJ_GATEWAY_PORT=8080

# ---- Worker ----
MJ_WORKER_CONCURRENCY=4

# ---- LLM ----
# 当前默认走 Qwen DashScope（OpenAI 兼容模式），也可以换成原生 openai / anthropic / ollama
# 必填：api_key
# 推荐模型（按效果/价格排序）：
#   qwen-max         最强，支持 function calling
#   qwen-plus        性价比首选，支持 function calling  ← 默认
#   qwen-turbo       最便宜，速度快，function calling 能力稍弱
#   qwen-long        超长上下文（适合多回合）
MJ_LLM_PROVIDER=openai
MJ_LLM_MODEL=qwen-plus
MJ_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 国内默认；如果你的账号在阿里云国际站，把域名换成 dashscope-intl.aliycs.com
MJ_LLM_BASE_URL=https://dashscope.aliycs.com/compatible-mode/v1
MJ_LLM_TEMPERATURE=0.2

# ---- 如果换成 OpenAI 官方，把上面改成下面这套 ----
# MJ_LLM_PROVIDER=openai
# MJ_LLM_MODEL=gpt-4o-mini
# MJ_LLM_API_KEY=sk-openai-xxx
# MJ_LLM_BASE_URL=
# MJ_LLM_TEMPERATURE=0.2

# ---- 如果换成 Anthropic ----
# MJ_LLM_PROVIDER=anthropic
# MJ_LLM_MODEL=claude-3-5-sonnet-latest
# MJ_LLM_API_KEY=sk-ant-xxx
# MJ_LLM_BASE_URL=
# MJ_LLM_TEMPERATURE=0.2

# ---- 如果换成本地 ollama ----
# MJ_LLM_PROVIDER=ollama
# MJ_LLM_MODEL=qwen2.5:7b
# MJ_LLM_API_KEY=ollama
# MJ_LLM_BASE_URL=http://localhost:11434/v1

# ---- MCP ----
# 留空则用 config/config.yaml 的 mcp.servers
MJ_MCP_ENABLED=true
